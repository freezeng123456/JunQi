arr:
  ema_decay: 0.999
  enabled: true
  n_arr: 1024
  net:
    depth: 4
    dropout: 0.0
    embed_dim: 512
    ff_factor: 4
    n_head: 8
    n_vf_cat: 3
    pos_emb_std: 0.1
    use_cat_vf: true
  ppo:
    autocast_dtype: bfloat16
    batch_size: 256
    clip_range: 0.2
    ent_pred_coef: 0.5
    kl_coef: 0.1
    lr: 0.0003
    max_grad_norm: 0.5
    num_epoch_per_train: 4
    policy_coef: 1.0
    vf_coef: 0.5
    weight_decay: 0.0
  refresh_every: 1
  reg_norm: 10.0
  reg_temp_decay: 0.3
  reg_temp_floor: 0.0
  reg_temp_init: 0.1
  storage_duration: 300
belief:
  buffer_capacity: 50000
  ema_decay: 0.999
  enabled: true
  infer_chunk_size: 256
  net:
    dropout: 0.1
    embed_dim: 512
    ff_factor: 4
    n_encoder_layer: 6
    n_head: 8
  ppo: null
  refresh_every: 5
  warmup_rollouts: 100
device: cuda:0
early_stop_min_rollout: 200
early_stop_patience: 5
early_stop_win_rate: 0.45
env:
  max_num_moves: 4000
  num_envs: 384
  seed: 135
  steps_per_env: 512
  use_gpu_rollout: true
eval_every: 10
log_every: 5
net:
  action_key_dim: 48
  cnn_channels: 96
  cnn_layers: 3
  depth: 6
  dropout: 0.0
  embed_dim: 192
  ff_factor: 4
  n_head: 6
  pos_emb_std: 0.02
  use_cat_vf: true
ppo:
  adv_filt_rate: 0.75
  adv_filt_thresh: 0.01
  clip_range: 0.2
  dtype: bfloat16
  ema_decay: 0.999
  gae_lambda: 0.5
  gamma: 1.0
  kl_coef: 0.1
  lr_ceil: 0.0001
  lr_coef: 0.5
  lr_decay: 1.1
  lr_floor: 5.0e-06
  max_grad_norm: 0.5
  minibatch_size: 1024
  net:
    action_key_dim: 48
    cnn_channels: 96
    cnn_layers: 3
    depth: 6
    dropout: 0.0
    embed_dim: 192
    ff_factor: 4
    n_head: 6
    pos_emb_std: 0.02
    use_cat_vf: true
  num_epochs_per_rollout: 4
  policy_coef: 1.0
  td_lambda: 0.8
  temperature_ceil: 0.1
  temperature_coef: 0.05
  temperature_decay: 0.3
  temperature_floor: 0.001
  torch_compile: false
  uniform_magnet: true
  vf_coef: 1.0
  weight_decay: 0.0
random_opponent: true
resume: ''
save_dir: exps/v35_ddp_combat_memory
save_every: 50
seed: 135
torch_deterministic: false
total_rollouts: 1500
use_wandb: false
wandb_project: junqi-rl
wandb_run_name: v35_ddp_combat_memory
